+func TestStreamedToolIDsAndArgumentsRemainConsistent(t *testing.T) {
+	adapter := openai.NewOpenAIAdapter(format.CorePluginHooks{})
+	ch := make(chan format.CoreStreamEvent, 16)
+	for _, idx := range []int{2, 5} {
+		ch <- format.CoreStreamEvent{Type: format.CoreContentBlockStarted, Index: idx, ContentBlock: &format.CoreContentBlock{Type: "tool_use", ToolUseID: fmt.Sprintf("call_%d", idx), ToolName: "read_file", ToolInput: json.RawMessage(`{}`)}}
+	}
+	for _, idx := range []int{5, 2} {
+		ch <- format.CoreStreamEvent{Type: format.CoreToolCallArgsDelta, Index: idx, Delta: `{"path":`}
+		ch <- format.CoreStreamEvent{Type: format.CoreToolCallArgsDelta, Index: idx, Delta: `"fixture.txt"}`}
+		ch <- format.CoreStreamEvent{Type: format.CoreToolCallArgsDone, Index: idx, Delta: `{"path":"fixture.txt"}`}
+		ch <- format.CoreStreamEvent{Type: format.CoreContentBlockDone, Index: idx}
+	}
+	ch <- format.CoreStreamEvent{Type: format.CoreEventCompleted, Status: "completed"}
+	close(ch)
+	result, err := adapter.FromCoreStream(context.Background(), &format.CoreRequest{Model: "any-model"}, ch)
+	if err != nil {
+		t.Fatal(err)
+	}
+	arguments := map[string]string{}
+	done := 0
+	for event := range result.(*openai.OpenAIStreamResult).Chan() {
+		switch event.Event {
+		case "response.output_item.added":
+			item := event.Data.(openai.OutputItemEvent).Item
+			if item.Type == "function_call" {
+				if item.ID == "" || item.Arguments != "" {
+					t.Fatalf("invalid initial item: %+v", item)
+				}
+				arguments[item.ID] = item.Arguments
+			}
+		case "response.function_call_arguments.delta":
+			delta := event.Data.(openai.FunctionCallArgumentsDeltaEvent)
+			if _, ok := arguments[delta.ItemID]; !ok {
+				t.Fatalf("unknown item ID: %s", delta.ItemID)
+			}
+			arguments[delta.ItemID] += delta.Delta
+		case "response.function_call_arguments.done":
+			item := event.Data.(openai.FunctionCallArgumentsDoneEvent)
+			if arguments[item.ItemID] != item.Arguments {
+				t.Fatalf("arguments mismatch: %+v", item)
+			}
+			done++
+		case "response.output_item.done":
+			item := event.Data.(openai.OutputItemEvent).Item
+			if item.Type == "function_call" && arguments[item.ID] != item.Arguments {
+				t.Fatalf("final item mismatch: %+v", item)
+			}
+		}
+	}
+	if done != 2 {
+		t.Fatalf("completed %d tool calls", done)
+	}
+}
