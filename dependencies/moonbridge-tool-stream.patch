+// A streaming tool call starts with no arguments, not a completed empty JSON
+// object. Clients concatenate later deltas onto this initial string.
+func streamingToolInputString(input json.RawMessage) string {
+	value := strings.TrimSpace(string(input))
+	if value == "" || value == "null" || value == "{}" {
+		return ""
+	}
+	return value
+}
