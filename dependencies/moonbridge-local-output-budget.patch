+func TestLocalOutputDefaultHonorsRouteBudget(t *testing.T) {
+ for _, tc := range []struct{ requested, global, route, want int }{
+  {0,65536,8192,8192}, {256,65536,8192,256}, {0,1024,8192,1024}, {0,65536,0,0}, {0,0,8192,8192},
+ } {
+  req:=&format.CoreRequest{MaxTokens:tc.requested}
+  cfg:=config.Config{DefaultMaxTokens:tc.global,Routes:map[string]config.RouteEntry{"local":{MaxOutputTokens:tc.route}}}
+  applyLocalOutputDefault(req,cfg,"local")
+  if req.MaxTokens!=tc.want {t.Fatalf("%+v: got %d",tc,req.MaxTokens)}
+ }
+}
