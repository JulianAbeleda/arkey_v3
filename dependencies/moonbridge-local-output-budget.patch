+// Bound an omitted local output budget by route metadata, preserving explicit requests.
+func applyLocalOutputDefault(req *format.CoreRequest, cfg config.Config, alias string) {
+ if req.MaxTokens > 0 { return }
+ limit := cfg.RouteFor(alias).MaxOutputTokens
+ if limit <= 0 { return }
+ if cfg.DefaultMaxTokens > 0 && cfg.DefaultMaxTokens < limit { limit = cfg.DefaultMaxTokens }
+ req.MaxTokens = limit
+}
