# Pinned external dependency used by Arkey v3.
# @modelcontextprotocol/server-brave-search ships a client-side rate limiter
# that throws instead of queueing; Arkey patches it in place (see
# dependencies/brave-search-rate-limit.patch) after installing this exact
# pinned version.
BRAVE_SEARCH_PACKAGE="@modelcontextprotocol/server-brave-search"
BRAVE_SEARCH_VERSION="0.6.2"
