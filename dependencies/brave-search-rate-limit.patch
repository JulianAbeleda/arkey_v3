+// Patched for Arkey: the upstream limiter threw on the second call within a
+// one-second window, which turns a pacing problem into a tool failure. An agent
+// that fires several searches then sees errors will improvise a retry loop and
+// burn context. Queue instead: serialise callers and wait out the window. The
+// monthly quota is a real ceiling and still throws.
+let rateGate = Promise.resolve();
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+async function checkRateLimit() {
+    const wait = rateGate.then(async () => {
+        for (;;) {
+            const now = Date.now();
+            if (now - requestCount.lastReset > 1000) {
+                requestCount.second = 0;
+                requestCount.lastReset = now;
+            }
+            if (requestCount.month >= RATE_LIMIT.perMonth) {
+                throw new Error('Rate limit exceeded: monthly quota');
+            }
+            if (requestCount.second < RATE_LIMIT.perSecond) {
+                requestCount.second++;
+                requestCount.month++;
+                return;
+            }
+            await sleep(1000 - (now - requestCount.lastReset) + 25);
+        }
+    });
+    rateGate = wait.catch(() => {});
+    return wait;
 }
