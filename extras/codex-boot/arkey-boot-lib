#!/usr/bin/env bash

ARKEY_USER_HOME="${ARKEY_USER_HOME:-${HOME:?HOME is required}}"
ARKEY_CONFIG_DIR="${ARKEY_CONFIG_DIR:-${XDG_CONFIG_HOME:-${ARKEY_USER_HOME}/.config}/arkey}"
ARKEY_BACKEND_FILE="${ARKEY_BACKEND_FILE:-${ARKEY_CONFIG_DIR}/backend}"
ARKEY_MODE_FILE="${ARKEY_MODE_FILE:-${ARKEY_CONFIG_DIR}/mode}"
ARKEY_LOCAL_RUNTIME_FILE="${ARKEY_LOCAL_RUNTIME_FILE:-${ARKEY_CONFIG_DIR}/local-runtime}"
ARKEY_LOCAL_MODEL_FILE="${ARKEY_LOCAL_MODEL_FILE:-${ARKEY_CONFIG_DIR}/local-model}"
ARKEY_GPU_VENDOR_FILE="${ARKEY_GPU_VENDOR_FILE:-${ARKEY_CONFIG_DIR}/gpu-vendor}"
ARKEY_GPU_NAME_FILE="${ARKEY_GPU_NAME_FILE:-${ARKEY_CONFIG_DIR}/gpu-name}"
ARKEY_LLAMA_SERVER_FILE="${ARKEY_LLAMA_SERVER_FILE:-${ARKEY_CONFIG_DIR}/llama-server}"

arkey_read_choice() {
  local file="$1" fallback="$2" value=""
  shift 2
  if [[ -f "$file" ]]; then IFS= read -r value < "$file" || true; fi
  local allowed
  for allowed in "$@"; do
    if [[ "$value" == "$allowed" ]]; then printf '%s' "$value"; return; fi
  done
  printf '%s' "$fallback"
}

arkey_save_value() {
  local file="$1" value="$2" tmp
  mkdir -p "$ARKEY_CONFIG_DIR"
  tmp="$(mktemp "${ARKEY_CONFIG_DIR}/.state.XXXXXX")"
  printf '%s\n' "$value" > "$tmp"
  chmod 0600 "$tmp"
  mv "$tmp" "$file"
}

arkey_load_mode() { arkey_read_choice "$ARKEY_MODE_FILE" frontier frontier local; }
arkey_save_mode() {
  case "$1" in frontier|local) arkey_save_value "$ARKEY_MODE_FILE" "$1" ;; *) return 2 ;; esac
}

arkey_backend_model() {
  case "$1" in
    deepseek) printf '%s' "${ARKEY_DEEPSEEK_MODEL:-deepseek-v4-pro}" ;;
    codex) printf '%s' "${ARKEY_CODEX_MODEL:-gpt-5.6-sol}" ;;
    claude) printf '%s' "${ARKEY_CLAUDE_MODEL:-claude-sonnet-4-6}" ;;
    *) return 1 ;;
  esac
}

arkey_backend_label() {
  case "$1" in
    deepseek) printf '%s' "DeepSeek" ;;
    codex) printf '%s' "Codex" ;;
    claude) printf '%s' "Claude" ;;
    *) return 1 ;;
  esac
}

arkey_load_backend() {
  arkey_read_choice "$ARKEY_BACKEND_FILE" deepseek deepseek codex claude
}

arkey_save_backend() {
  local backend="$1"
  case "$backend" in
    deepseek|codex|claude) ;;
    *) return 2 ;;
  esac
  arkey_save_value "$ARKEY_BACKEND_FILE" "$backend"
}

arkey_load_local_runtime() { arkey_read_choice "$ARKEY_LOCAL_RUNTIME_FILE" llama llama; }
arkey_save_local_runtime() {
  case "$1" in llama) arkey_save_value "$ARKEY_LOCAL_RUNTIME_FILE" "$1" ;; *) return 2 ;; esac
}

arkey_load_local_model() {
  local model=""
  if [[ -f "$ARKEY_LOCAL_MODEL_FILE" ]]; then IFS= read -r model < "$ARKEY_LOCAL_MODEL_FILE" || true; fi
  [[ -f "$model" && "$model" == *.gguf ]] && printf '%s' "$model"
  return 0
}

arkey_save_local_model() {
  [[ -f "$1" && "$1" == *.gguf ]] || return 2
  arkey_save_value "$ARKEY_LOCAL_MODEL_FILE" "$1"
}

arkey_load_gpu_vendor() { arkey_read_choice "$ARKEY_GPU_VENDOR_FILE" unknown unknown nvidia amd; }
arkey_save_gpu_vendor() {
  case "$1" in nvidia|amd) arkey_save_value "$ARKEY_GPU_VENDOR_FILE" "$1" ;; *) return 2 ;; esac
}

arkey_load_gpu_name() {
  local name=""
  if [[ -f "$ARKEY_GPU_NAME_FILE" ]]; then IFS= read -r name < "$ARKEY_GPU_NAME_FILE" || true; fi
  printf '%s' "$name"
}
arkey_save_gpu_name() { [[ -n "$1" ]] && arkey_save_value "$ARKEY_GPU_NAME_FILE" "$1"; }

arkey_load_llama_server() {
  local server=""
  if [[ -f "$ARKEY_LLAMA_SERVER_FILE" ]]; then IFS= read -r server < "$ARKEY_LLAMA_SERVER_FILE" || true; fi
  [[ -x "$server" ]] && printf '%s' "$server"
  return 0
}
arkey_save_llama_server() { [[ -x "$1" ]] && arkey_save_value "$ARKEY_LLAMA_SERVER_FILE" "$1"; }

arkey_selected_model() {
  if [[ "$(arkey_load_mode)" == local ]]; then
    printf 'arkey-local-%s' "$(arkey_load_local_runtime)"
  else
    arkey_backend_model "$(arkey_load_backend)"
  fi
}
