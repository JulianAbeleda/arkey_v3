#!/usr/bin/env bash
set -euo pipefail

ARKEY_USER_HOME="${ARKEY_USER_HOME:-${HOME:?HOME is required}}"
LOCAL_BIN="${ARKEY_LOCAL_BIN:-${ARKEY_USER_HOME}/.local/bin}"
MOONBRIDGE_DIR="${MOONBRIDGE_DIR:-${ARKEY_USER_HOME}/moon-bridge}"
MODEL_DIR="${ARKEY_MODEL_DIR:-${ARKEY_USER_HOME}/models}"
PATH="${LOCAL_BIN}:${PATH:-/usr/local/bin:/usr/bin:/bin}"

ARKEY_BIN="${ARKEY_BIN:-${LOCAL_BIN}/arkey}"
BOOT_LIB="${ARKEY_BOOT_LIB:-${LOCAL_BIN}/arkey-boot-lib}"
LOCAL_MANAGER="${ARKEY_LOCAL_MANAGER:-${LOCAL_BIN}/arkey-local-runtime}"
HARDWARE_SCAN="${ARKEY_HARDWARE_SCAN:-${LOCAL_BIN}/arkey-hardware-scan}"
CODEX_MOONBRIDGE_BIN="${CODEX_MOONBRIDGE_BIN:-${LOCAL_BIN}/codex-moonbridge}"
CODEX_BIN="${CODEX_BIN:-${LOCAL_BIN}/codex-openai}"
MOONBRIDGE_ADDR="${MOONBRIDGE_ADDR:-127.0.0.1:38440}"
MOONBRIDGE_CONFIG="${MOONBRIDGE_CONFIG:-${MOONBRIDGE_DIR}/config.yml}"

if [[ ! -r "$BOOT_LIB" ]]; then
  echo "Arkey boot configuration library is missing: $BOOT_LIB" >&2
  exit 1
fi
# shellcheck source=arkey-boot-lib
source "$BOOT_LIB"

esc=$'\033'
reset="${esc}[0m"; bold="${esc}[1m"
fg_blue="${esc}[38;5;111m"; fg_green="${esc}[38;5;120m"; fg_yellow="${esc}[38;5;222m"
fg_red="${esc}[38;5;203m"; fg_purple="${esc}[38;5;141m"; fg_text="${esc}[38;5;189m"; fg_muted="${esc}[38;5;103m"
bg_panel="${esc}[48;5;235m"; alt_screen="${esc}[?1049h"; main_screen="${esc}[?1049l"
hide_cursor="${esc}[?25l"; show_cursor="${esc}[?25h"; home="${esc}[H"; clear_to_end="${esc}[J"

RUNTIME_STATE=""; BRIDGE_STATE=""; WORKSPACE=""; SELECTED_MODE=""
SELECTED_BACKEND=""; SELECTED_LABEL=""; SELECTED_MODEL=""; LOCAL_RUNTIME=""; LOCAL_MODEL=""
DRAWN_ONCE=0
LOCAL_MODELS=()
MENU_COLS=80; MENU_ROWS=24

update_geometry() {
  local cols="${COLUMNS:-}" rows="${LINES:-}"
  if [[ -t 1 ]] && command -v tput >/dev/null 2>&1; then
    cols="$(tput cols 2>/dev/null || printf '%s' "${cols:-80}")"
    rows="$(tput lines 2>/dev/null || printf '%s' "${rows:-24}")"
  fi
  [[ "$cols" =~ ^[0-9]+$ ]] || cols=80
  [[ "$rows" =~ ^[0-9]+$ ]] || rows=24
  [[ "$cols" -lt 40 ]] && cols=40
  [[ "$rows" -lt 12 ]] && rows=12
  MENU_COLS="$cols"; MENU_ROWS="$rows"
}

strip_ansi() { sed $'s/\033\\[[0-9;]*m//g' <<<"$1"; }
truncate_text() {
  local value="$1" width="$2"
  if [[ "${#value}" -le "$width" ]]; then printf '%s' "$value"
  elif [[ "$width" -le 3 ]]; then printf '%.*s' "$width" "$value"
  else printf '%s...' "${value:0:$((width-3))}"; fi
}
state_color() {
  local value="${1,,}"
  case "$value" in
    *unavailable*|*not\ configured*|*missing*|*failed*|*mismatch*) printf '%s' "$fg_red" ;;
    *development*) printf '%s' "$fg_muted" ;;
    *ready*|*online*|*configured*|*loaded*|*aligned*|*selected*) printf '%s' "$fg_green" ;;
    *stopped*|*standby*|*running*|*scan\ needed*|*not\ scanned*) printf '%s' "$fg_yellow" ;;
    *) printf '%s' "$fg_text" ;;
  esac
}

render_line() {
  local content="$1" plain max_width
  max_width=$((MENU_COLS - 3))
  plain="$(strip_ansi "$content")"
  if [[ "${#plain}" -le "$max_width" ]]; then printf '  %s\n' "$content"
  else printf '  %s%s%s\n' "$fg_muted" "$(truncate_text "$plain" "$max_width")" "$reset"; fi
}

restore_terminal() { printf '%s%s%s' "$reset" "$show_cursor" "$main_screen"; }
enter_menu_screen() {
  printf '%s%s' "$alt_screen" "$hide_cursor"
  trap restore_terminal EXIT
  trap 'exit 130' INT; trap 'exit 143' TERM; trap 'exit 129' HUP
}

runtime_ready() {
  [[ -x "$CODEX_MOONBRIDGE_BIN" && -x "$CODEX_BIN" && -f "$MOONBRIDGE_CONFIG" ]] &&
    command -v curl >/dev/null 2>&1 && command -v go >/dev/null 2>&1
}
runtime_state() {
  if runtime_ready; then printf '%sready%s' "$fg_green" "$reset"; else printf '%sincomplete%s' "$fg_yellow" "$reset"; fi
}
bridge_state() {
  if curl -fsS --max-time 0.4 "http://${MOONBRIDGE_ADDR}/v1/models" >/dev/null 2>&1; then printf '%sonline%s' "$fg_green" "$reset"
  elif runtime_ready; then printf '%sstandby%s' "$fg_yellow" "$reset"; else printf '%sunavailable%s' "$fg_red" "$reset"; fi
}

model_configured() {
  local model="$1" response
  if response="$(curl -fsS --max-time 0.4 "http://${MOONBRIDGE_ADDR}/v1/models" 2>/dev/null)"; then
    if command -v jq >/dev/null 2>&1; then
      jq -e --arg model "$model" '
        (.data[]? | select(.id == $model)) //
        (.models[]? | select(.name == $model or .model == $model or .slug == $model or (.slug? | endswith("/" + $model))))
      ' <<<"$response" >/dev/null 2>&1
    else grep -Fq "\"$model\"" <<<"$response"; fi
  else
    grep -Eq "^[[:space:]]{2}${model}:" "$MOONBRIDGE_CONFIG" 2>/dev/null
  fi
}
backend_configured() { model_configured "$(arkey_backend_model "$1")"; }
backend_status() {
  if backend_configured "$1"; then printf '%sconfigured%s' "$fg_green" "$reset"; else printf '%snot configured%s' "$fg_yellow" "$reset"; fi
}
local_route_configured() { model_configured "arkey-local-$1"; }
local_server_ready() {
  local runtime="$1" model="${2:-}"
  [[ -x "$LOCAL_MANAGER" ]] || return 1
  if [[ -n "$model" ]]; then "$LOCAL_MANAGER" status "$runtime" "$model" >/dev/null 2>&1
  else "$LOCAL_MANAGER" status "$runtime" >/dev/null 2>&1; fi
}
local_status() {
  local runtime="$1"
  if [[ "$runtime" == tinygrad ]]; then printf '%sin development%s' "$fg_muted" "$reset"
  elif ! local_route_configured "$runtime"; then printf '%sroute unavailable%s' "$fg_red" "$reset"
  elif [[ "$runtime" == "$LOCAL_RUNTIME" && -n "$LOCAL_MODEL" ]] && local_server_ready "$runtime" "$LOCAL_MODEL"; then printf '%sloaded%s' "$fg_green" "$reset"
  elif local_server_ready "$runtime"; then printf '%srunning%s' "$fg_yellow" "$reset"
  else printf '%sstopped%s' "$fg_yellow" "$reset"; fi
}

refresh_status() {
  RUNTIME_STATE="$(runtime_state)"; BRIDGE_STATE="$(bridge_state)"; SELECTED_MODE="$(arkey_load_mode)"
  SELECTED_BACKEND="$(arkey_load_backend)"; SELECTED_LABEL="$(arkey_backend_label "$SELECTED_BACKEND")"
  LOCAL_RUNTIME="$(arkey_load_local_runtime)"; LOCAL_MODEL="$(arkey_load_local_model)"
  if [[ "$SELECTED_MODE" == local ]]; then
    SELECTED_LABEL="Local · $LOCAL_RUNTIME"
    SELECTED_MODEL="${LOCAL_MODEL:+$(basename "$LOCAL_MODEL")}"; SELECTED_MODEL="${SELECTED_MODEL:-no model selected}"
  else SELECTED_MODEL="$(arkey_backend_model "$SELECTED_BACKEND")"; fi
  if [[ "$PWD" == "$ARKEY_USER_HOME" ]]; then WORKSPACE="~"
  elif [[ "$PWD" == "$ARKEY_USER_HOME/"* ]]; then WORKSPACE="~${PWD#"$ARKEY_USER_HOME"}"; else WORKSPACE="$PWD"; fi
  DRAWN_ONCE=0
}

menu_row() {
  local selected="$1" idx="$2" key="$3" label="$4" detail="$5" state="$6"
  local label_width=22 state_width=18 detail_width plain_state color
  if [[ "$MENU_COLS" -lt 70 ]]; then label_width=16; state_width=12; fi
  detail_width=$((MENU_COLS - 8 - label_width - state_width - 3))
  if [[ "$detail_width" -lt 8 ]]; then
    label_width=12; state_width=10
    detail_width=$((MENU_COLS - 8 - label_width - state_width - 3))
  fi
  label="$(truncate_text "$label" "$label_width")"
  detail="$(truncate_text "$detail" "$detail_width")"
  plain_state="$(strip_ansi "$state")"
  plain_state="$(truncate_text "$plain_state" "$state_width")"
  color="$(state_color "$plain_state")"
  if [[ "$selected" -eq "$idx" ]]; then
    printf '  %b> %2s  %-*s %s%-*s%s %s%-*s%s%s\n' \
      "$bg_panel$bold$fg_text" "$key" "$label_width" "$label" "$fg_muted" "$detail_width" "$detail" "$reset$bg_panel" "$color" "$state_width" "$plain_state" "$reset"
  else
    printf '    %s%2s%s  %-*s %s%-*s%s %s%-*s%s\n' \
      "$fg_blue" "$key" "$reset" "$label_width" "$label" "$fg_muted" "$detail_width" "$detail" "$reset" "$color" "$state_width" "$plain_state" "$reset"
  fi
}
draw_header() {
  local title="$1" fill="$2"
  update_geometry
  fill=$((MENU_COLS - ${#title} - 5)); [[ "$fill" -lt 1 ]] && fill=1
  printf '%s%s' "$home" "$clear_to_end"; DRAWN_ONCE=1
  printf '\n  %s%s %s %s%s\n' "$bold" "$fg_blue" "$title" "$(printf '%*s' "$fill" '' | tr ' ' '=')" "$reset"
}
footer() { printf '\n  %s%s%s\n' "$fg_blue" "$(printf '%*s' "$((MENU_COLS-4))" '' | tr ' ' '=')" "$reset"; }

draw_main_menu() {
  local selected="$1" route_state
  [[ "$SELECTED_MODE" == local ]] && route_state="$(local_status "$LOCAL_RUNTIME")" || route_state="$(backend_status "$SELECTED_BACKEND")"
  draw_header "ARKEY BOOT" 55
  render_line "${fg_muted}Workspace${reset} ${fg_text}${WORKSPACE}${reset}"
  render_line "${fg_muted}Runtime${reset}   Arkey Codex [${RUNTIME_STATE}]   MoonBridge [${BRIDGE_STATE}]"
  render_line "${fg_muted}AI route${reset}  ${fg_text}${SELECTED_LABEL}${reset}  ${fg_muted}(${SELECTED_MODEL})${reset}"; printf '\n'
  menu_row "$selected" 1 1 "TUI" "choose the modded client" "${fg_text}Arkey Codex${reset}"
  menu_row "$selected" 2 2 "Config" "routes and hardware" "$route_state"
  menu_row "$selected" 3 3 "Exit" "close Arkey" "${fg_text}quit${reset}"
  footer; render_line "${fg_muted}Up/Down${reset} move   ${fg_muted}Right/Enter${reset} select   ${fg_muted}Left${reset} back   ${fg_muted}Q${reset} quit"; printf '\n'
}

draw_tui_menu() {
  local status
  [[ "$SELECTED_MODE" == local ]] && status="$(local_status "$LOCAL_RUNTIME")" || status="$(backend_status "$SELECTED_BACKEND")"
  draw_header "TUI" 62
  render_line "${fg_muted}Arkey-modified terminal clients; Arkey Codex is not official Codex.${reset}"
  render_line "${fg_muted}AI route${reset} ${fg_text}${SELECTED_LABEL}${reset} via MoonBridge"; printf '\n'
  menu_row 1 1 1 "Arkey Codex (modded)" "custom client, not official Codex" "$status"
  footer; render_line "${fg_muted}Right/Enter/1${reset} launch   ${fg_muted}Left/B${reset} back   ${fg_muted}Q${reset} quit"; printf '\n'
}

draw_config_root() {
  local selected="$1" local_state frontier_state gpu_state
  local_state="$(local_status "$LOCAL_RUNTIME")"; frontier_state="$(backend_status "$SELECTED_BACKEND")"
  if [[ -x "$HARDWARE_SCAN" ]]; then gpu_state="$($HARDWARE_SCAN summary 2>/dev/null || printf 'scan needed')"
  else gpu_state="scanner missing"; fi
  draw_header "CONFIG" 59
  render_line "${fg_muted}Configure AI routes and local hardware alignment.${reset}"; printf '\n'
  menu_row "$selected" 1 1 "Local" "runtime → installed model" "$local_state"
  menu_row "$selected" 2 2 "Frontier" "hosted AI provider" "$frontier_state"
  menu_row "$selected" 3 3 "GPU Auto-scan" "detect and align llama.cpp" "${fg_text}${gpu_state}${reset}"
  footer; render_line "${fg_muted}Up/Down${reset} move   ${fg_muted}Right/Enter${reset} open   ${fg_muted}Left/B${reset} back"; printf '\n'
}

run_gpu_scan() {
  DRAWN_ONCE=0; draw_header "CONFIG · GPU AUTO-SCAN" 43
  printf '\n'
  if [[ ! -x "$HARDWARE_SCAN" ]]; then
    printf '  %sHardware scanner is missing: %s%s\n' "$fg_red" "$HARDWARE_SCAN" "$reset"
  elif "$HARDWARE_SCAN" scan; then
    printf '\n  %sGPU and llama.cpp are aligned.%s\n' "$fg_green" "$reset"
  else
    printf '\n  %sAlignment failed; local serving was not changed.%s\n' "$fg_red" "$reset"
  fi
  printf '\n  Press Enter to return... '
  IFS= read -r _ || true; DRAWN_ONCE=0
}

frontier_row_state() {
  local backend="$1" state="$(backend_status "$1")"
  if [[ "$SELECTED_MODE" == frontier && "$backend" == "$SELECTED_BACKEND" ]]; then printf '%sselected%s · %b' "$fg_text" "$reset" "$state"; else printf '%b' "$state"; fi
}
draw_frontier_menu() {
  local selected="$1"
  draw_header "CONFIG · FRONTIER" 48
  render_line "${fg_muted}Choose the hosted AI MoonBridge serves into Arkey Codex.${reset}"; printf '\n'
  menu_row "$selected" 1 1 "DeepSeek" "$(arkey_backend_model deepseek)" "$(frontier_row_state deepseek)"
  menu_row "$selected" 2 2 "Codex" "$(arkey_backend_model codex)" "$(frontier_row_state codex)"
  menu_row "$selected" 3 3 "Claude" "$(arkey_backend_model claude)" "$(frontier_row_state claude)"
  footer; render_line "${fg_muted}Up/Down${reset} move   ${fg_muted}Right/Enter${reset} set   ${fg_muted}Left/B${reset} back"; printf '\n'
}

draw_local_runtime_menu() {
  local selected="$1"
  draw_header "CONFIG · LOCAL SERVER" 44
  render_line "${fg_muted}Choose the runtime that will load and serve a local GGUF.${reset}"; printf '\n'
  menu_row "$selected" 1 1 "tinygrad" "coming later · unavailable" "$(local_status tinygrad)"
  menu_row "$selected" 2 2 "llama.cpp" "local GGUF server · :8080" "$(local_status llama)"
  footer; render_line "${fg_muted}Up/Down${reset} move   ${fg_muted}Right/Enter${reset} models   ${fg_muted}Left/B${reset} back"; printf '\n'
}

discover_models() {
  LOCAL_MODELS=()
  [[ -d "$MODEL_DIR" ]] && mapfile -d '' LOCAL_MODELS < <(find "$MODEL_DIR" -type f -iname '*.gguf' -print0 2>/dev/null | sort -z)
}
model_size() { numfmt --to=iec-i --suffix=B "$(stat -c %s "$1")" 2>/dev/null || printf '?'; }
draw_model_menu() {
  local selected="$1" runtime="$2" i path label key state start=0 end max_visible count
  draw_header "LOCAL · ${runtime^^} · MODELS" 37
  render_line "${fg_muted}Select a GGUF to load. The switch commits only after health checks pass.${reset}"; printf '\n'
  count="${#LOCAL_MODELS[@]}"; max_visible=$((MENU_ROWS - 10)); [[ "$max_visible" -lt 2 ]] && max_visible=2
  if [[ "$count" -eq 0 ]]; then render_line "${fg_yellow}No GGUF files found under ${MODEL_DIR}.${reset}"
  else
    if [[ "$count" -gt "$max_visible" ]]; then
      start=$((selected - 1 - max_visible / 2)); [[ "$start" -lt 0 ]] && start=0
      [[ $((start + max_visible)) -gt "$count" ]] && start=$((count - max_visible))
      end=$((start + max_visible))
      render_line "${fg_muted}Models $((start+1))-${end} of ${count}${reset}"
    else end="$count"; fi
    for ((i=start; i<end; i++)); do
      path="${LOCAL_MODELS[$i]}"; label="$(basename "$path" .gguf)"; key=$((i+1)); state="${fg_muted}$(model_size "$path")${reset}"
      [[ "$path" == "$LOCAL_MODEL" && "$runtime" == "$LOCAL_RUNTIME" && "$SELECTED_MODE" == local ]] && state="${fg_text}selected${reset} · $state"
      menu_row "$selected" "$key" "$key" "$label" "$(dirname "${path#"$MODEL_DIR"/}")" "$state"
    done
  fi
  footer; render_line "${fg_muted}Up/Down${reset} move   ${fg_muted}Right/Enter${reset} load   ${fg_muted}1-9${reset} quick load   ${fg_muted}Left/B${reset} back"; printf '\n'
}

draw_message() {
  local title="$1" color="$2" message="$3"
  DRAWN_ONCE=0; draw_header "$title" 42
  printf '\n  %s%s%s\n\n  Press Enter to return... ' "$color" "$message" "$reset"
  IFS= read -r _ || true; DRAWN_ONCE=0
}

read_nav_key() {
  local __result_var="$1" key rest value
  if ! IFS= read -rsn1 key; then printf -v "$__result_var" '%s' quit; return; fi
  case "$key" in
    "") value=enter ;; [0-9]) value="$key" ;; b|B) value=back ;; q|Q) value=quit ;;
    $'\033')
      IFS= read -rsn2 -t 0.1 rest || true
      case "$rest" in "[A") value=prev ;; "[B") value=next ;; "[C") value=enter ;; "[D") value=back ;; *) value="" ;; esac ;;
    *) value="" ;;
  esac
  printf -v "$__result_var" '%s' "$value"
}

handoff() { restore_terminal; trap - EXIT INT TERM HUP; exec "$@"; }

ensure_local_loaded() {
  [[ -n "$LOCAL_MODEL" && -f "$LOCAL_MODEL" ]] || { draw_message "NO LOCAL MODEL" "$fg_yellow" "Choose Config → Local → runtime → model first."; return 1; }
  if ! local_server_ready "$LOCAL_RUNTIME" "$LOCAL_MODEL"; then
    DRAWN_ONCE=0; draw_header "LOADING LOCAL MODEL" 41
    printf '\n  Runtime: %s%s%s\n  Model:   %s%s%s\n\n' "$fg_text" "$LOCAL_RUNTIME" "$reset" "$fg_text" "$(basename "$LOCAL_MODEL")" "$reset"
    if ! "$LOCAL_MANAGER" start "$LOCAL_RUNTIME" "$LOCAL_MODEL"; then
      printf '\n  %sLoad failed. Press Enter to return...%s ' "$fg_red" "$reset"; IFS= read -r _ || true; DRAWN_ONCE=0; return 1
    fi
  fi
}

launch_arkey_codex() {
  if [[ "$SELECTED_MODE" == local ]]; then
    ensure_local_loaded || return
    handoff "$ARKEY_BIN" --no-boot -m "arkey-local-${LOCAL_RUNTIME}"
  fi
  if ! backend_configured "$SELECTED_BACKEND"; then
    draw_message "BACKEND NOT CONFIGURED" "$fg_yellow" "$SELECTED_LABEL ($SELECTED_MODEL) is not in MoonBridge's catalog."
    return
  fi
  handoff "$ARKEY_BIN" --no-boot -m "$SELECTED_MODEL"
}

activate_local_model() {
  local runtime="$1" model="$2"
  DRAWN_ONCE=0; draw_header "LOADING LOCAL MODEL" 41
  printf '\n  Runtime: %s%s%s\n  Model:   %s%s%s\n\n' "$fg_text" "$runtime" "$reset" "$fg_text" "$(basename "$model")" "$reset"
  if "$LOCAL_MANAGER" start "$runtime" "$model"; then
    arkey_save_local_runtime "$runtime"; arkey_save_local_model "$model"; arkey_save_mode local; refresh_status
    printf '\n  %sLocal route is ready and selected.%s\n  Press Enter to continue... ' "$fg_green" "$reset"; IFS= read -r _ || true
  else
    printf '\n  %sLoad failed; the previous route remains selected.%s\n  Press Enter to return... ' "$fg_red" "$reset"; IFS= read -r _ || true
  fi
  DRAWN_ONCE=0
}

tui_menu_loop() {
  local action; DRAWN_ONCE=0
  while true; do draw_tui_menu; read_nav_key action; case "$action" in enter|1) launch_arkey_codex ;; back) DRAWN_ONCE=0; return ;; quit) exit 0 ;; esac; done
}

frontier_menu_loop() {
  local selected=1 action backend
  case "$SELECTED_BACKEND" in deepseek) selected=1 ;; codex) selected=2 ;; claude) selected=3 ;; esac
  DRAWN_ONCE=0
  while true; do
    draw_frontier_menu "$selected"; read_nav_key action
    case "$action" in
      enter|[1-3]) [[ "$action" == enter ]] || selected="$action"; case "$selected" in 1) backend=deepseek ;; 2) backend=codex ;; 3) backend=claude ;; esac
        arkey_save_backend "$backend"; arkey_save_mode frontier; refresh_status ;;
      back) DRAWN_ONCE=0; return ;; quit) exit 0 ;;
      prev) ((selected--)) || true; [[ "$selected" -lt 1 ]] && selected=3 ;; next) ((selected++)) || true; [[ "$selected" -gt 3 ]] && selected=1 ;;
    esac
  done
}

model_menu_loop() {
  local runtime="$1" selected=1 action count i
  discover_models; count="${#LOCAL_MODELS[@]}"; [[ "$count" -gt 0 ]] || selected=0
  for ((i=0; i<count; i++)); do [[ "${LOCAL_MODELS[$i]}" == "$LOCAL_MODEL" ]] && selected=$((i+1)); done
  DRAWN_ONCE=0
  while true; do
    draw_model_menu "$selected" "$runtime"; read_nav_key action
    case "$action" in
      enter) [[ "$selected" -gt 0 ]] && activate_local_model "$runtime" "${LOCAL_MODELS[$((selected-1))]}" ;;
      [1-9]) [[ "$action" -le "$count" ]] && { selected="$action"; activate_local_model "$runtime" "${LOCAL_MODELS[$((selected-1))]}"; } ;;
      back) DRAWN_ONCE=0; return ;; quit) exit 0 ;;
      prev) [[ "$count" -gt 0 ]] && { ((selected--)) || true; [[ "$selected" -lt 1 ]] && selected="$count"; } ;;
      next) [[ "$count" -gt 0 ]] && { ((selected++)) || true; [[ "$selected" -gt "$count" ]] && selected=1; } ;;
    esac
  done
}

local_runtime_menu_loop() {
  local selected=1 action runtime; [[ "$LOCAL_RUNTIME" == llama ]] && selected=2; DRAWN_ONCE=0
  while true; do
    draw_local_runtime_menu "$selected"; read_nav_key action
    case "$action" in
      enter|[12])
        [[ "$action" == enter ]] || selected="$action"
        if [[ "$selected" -eq 1 ]]; then
          draw_message "TINYGRAD · IN DEVELOPMENT" "$fg_yellow" "tinygrad local serving is not available yet. Use llama.cpp for now."
        else
          runtime=llama; model_menu_loop "$runtime"; refresh_status
        fi ;;
      back) DRAWN_ONCE=0; return ;; quit) exit 0 ;;
      prev|next) [[ "$selected" -eq 1 ]] && selected=2 || selected=1 ;;
    esac
  done
}

config_root_loop() {
  local selected=1 action; [[ "$SELECTED_MODE" == frontier ]] && selected=2; DRAWN_ONCE=0
  while true; do
    draw_config_root "$selected"; read_nav_key action
    case "$action" in
      enter) case "$selected" in 1) local_runtime_menu_loop ;; 2) frontier_menu_loop ;; 3) run_gpu_scan ;; esac; refresh_status ;;
      1) local_runtime_menu_loop; refresh_status ;; 2) frontier_menu_loop; refresh_status ;; 3) run_gpu_scan; refresh_status ;;
      back) DRAWN_ONCE=0; return ;; quit) exit 0 ;;
      prev) ((selected--)) || true; [[ "$selected" -lt 1 ]] && selected=3 ;;
      next) ((selected++)) || true; [[ "$selected" -gt 3 ]] && selected=1 ;;
    esac
  done
}

main_menu_loop() {
  local selected=1 action; enter_menu_screen; refresh_status
  while true; do
    draw_main_menu "$selected"; read_nav_key action
    case "$action" in
      enter) case "$selected" in 1) tui_menu_loop ;; 2) config_root_loop ;; 3) exit 0 ;; esac; refresh_status ;;
      1) tui_menu_loop; refresh_status ;; 2) config_root_loop; refresh_status ;; 3|quit) exit 0 ;;
      prev) ((selected--)) || true; [[ "$selected" -lt 1 ]] && selected=3 ;; next) ((selected++)) || true; [[ "$selected" -gt 3 ]] && selected=1 ;;
      back) : ;;
    esac
  done
}

main_menu_loop
