#!/usr/bin/env bash
set -euo pipefail

ARKEY_USER_HOME="${ARKEY_USER_HOME:-${HOME:?HOME is required}}"
BOOT_LIB="${ARKEY_BOOT_LIB:-${ARKEY_USER_HOME}/.local/bin/arkey-boot-lib}"
MODEL_CATALOG="${ARKEY_MODEL_CATALOG:-${ARKEY_USER_HOME}/.codex-moonbridge/models_catalog.json}"

if [[ ! -r "$BOOT_LIB" ]]; then
  echo "Arkey boot configuration library is missing: $BOOT_LIB" >&2
  exit 1
fi
# shellcheck source=arkey-boot-lib
source "$BOOT_LIB"

detect_vendor() {
  if [[ -n "${ARKEY_GPU_VENDOR_OVERRIDE:-}" ]]; then printf '%s' "$ARKEY_GPU_VENDOR_OVERRIDE"; return; fi
  if [[ -e /dev/nvidiactl ]] && command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi -L >/dev/null 2>&1; then
    printf '%s' nvidia
  elif [[ -e /dev/kfd ]] && { command -v rocminfo >/dev/null 2>&1 || command -v rocm-smi >/dev/null 2>&1; }; then
    printf '%s' amd
  else
    printf '%s' unknown
  fi
}

detect_name() {
  local vendor="$1" name=""
  if [[ -n "${ARKEY_GPU_NAME_OVERRIDE:-}" ]]; then printf '%s' "$ARKEY_GPU_NAME_OVERRIDE"; return; fi
  case "$vendor" in
    nvidia) name="$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | sed -n '1p')" ;;
    amd)
      name="$(rocminfo 2>/dev/null | sed -n 's/^[[:space:]]*Marketing Name:[[:space:]]*//p' | sed -n '1p')"
      [[ -n "$name" ]] || name="AMD GPU" ;;
    *) name="No supported GPU" ;;
  esac
  printf '%s' "$name"
}

binary_backend() {
  local server="$1" deps
  if [[ -n "${ARKEY_LLAMA_BACKEND_OVERRIDE:-}" ]]; then printf '%s' "$ARKEY_LLAMA_BACKEND_OVERRIDE"; return; fi
  deps="$(ldd "$server" 2>/dev/null || true)"
  if grep -Eqi 'libggml-cuda|libcuda|libcudart|libcublas' <<<"$deps"; then printf '%s' nvidia
  elif grep -Eqi 'libggml-hip|libamdhip|libhipblas|librocblas' <<<"$deps"; then printf '%s' amd
  else printf '%s' cpu; fi
}

candidate_servers() {
  local roots root
  if [[ -n "${ARKEY_LLAMA_CANDIDATES:-}" ]]; then
    tr ':' '\n' <<<"$ARKEY_LLAMA_CANDIDATES"
    return
  fi
  roots="${ARKEY_LLAMA_SEARCH_ROOTS:-${ARKEY_USER_HOME}/env:${ARKEY_USER_HOME}/worktrees:${ARKEY_USER_HOME}/llama.cpp}"
  while IFS= read -r root; do
    [[ -d "$root" ]] || continue
    find "$root" -maxdepth 8 -type f -path '*/bin/llama-server' -perm /111 -print 2>/dev/null
  done < <(tr ':' '\n' <<<"$roots")
}

find_aligned_server() {
  local vendor="$1" server backend
  while IFS= read -r server; do
    [[ -x "$server" ]] || continue
    backend="$(binary_backend "$server")"
    if [[ "$backend" == "$vendor" ]]; then printf '%s' "$server"; return 0; fi
  done < <(candidate_servers | sort -u)
  return 1
}

ensure_local_metadata() {
  local entry tmp
  [[ -f "$MODEL_CATALOG" ]] || { echo "Codex model catalog not found: $MODEL_CATALOG" >&2; return 1; }
  command -v jq >/dev/null 2>&1 || { echo 'jq is required to update Codex model metadata.' >&2; return 1; }
  entry="$(jq -n '{
    slug: "arkey-local-llama",
    display_name: "Arkey Local (llama.cpp)",
    default_reasoning_level: "medium",
    supported_reasoning_levels: [
      {effort: "low", description: "Low reasoning effort"},
      {effort: "medium", description: "Medium reasoning effort"},
      {effort: "high", description: "High reasoning effort"}
    ],
    shell_type: "unified_exec",
    visibility: "list",
    supported_in_api: true,
    priority: 0,
    additional_speed_tiers: [],
    availability_nux: null,
    upgrade: null,
    base_instructions: "You are Arkey Local, an Arkey-modified coding assistant running through llama.cpp. Work carefully with the provided tools and keep responses concise.",
    supports_reasoning_summaries: true,
    default_reasoning_summary: "auto",
    support_verbosity: false,
    default_verbosity: null,
    apply_patch_tool_type: "freeform",
    web_search_tool_type: "text",
    truncation_policy: {mode: "tokens", limit: 8000},
    supports_parallel_tool_calls: false,
    supports_image_detail_original: false,
    context_window: 32768,
    max_context_window: 32768,
    effective_context_window_percent: 90,
    experimental_supported_tools: [],
    input_modalities: ["text"],
    supports_search_tool: false
  }')"
  tmp="$(mktemp "$(dirname "$MODEL_CATALOG")/.models-catalog.XXXXXX")"
  if ! jq --argjson local "$entry" '.models = ([.models[]? | select(.slug != "arkey-local-llama")] + [$local])' \
    "$MODEL_CATALOG" > "$tmp"; then
    find "$tmp" -maxdepth 0 -type f -delete
    return 1
  fi
  chmod --reference="$MODEL_CATALOG" "$tmp"
  mv "$tmp" "$MODEL_CATALOG"
  printf 'Registered model metadata: arkey-local-llama\n'
}

summary() {
  local vendor detected name server backend
  vendor="$(arkey_load_gpu_vendor)"; name="$(arkey_load_gpu_name)"; server="$(arkey_load_llama_server)"
  detected="$(detect_vendor)"
  if [[ "$vendor" == unknown || -z "$server" ]]; then printf '%s\n' 'not scanned'; return; fi
  if [[ "$detected" != "$vendor" ]]; then printf '%s · rescan required\n' "${name:-$vendor}"; return; fi
  backend="$(binary_backend "$server")"
  if [[ "$backend" == "$vendor" ]]; then printf '%s · aligned\n' "${name:-$vendor}"
  else printf '%s · rescan required\n' "${name:-$vendor}"; fi
}

scan_gpu() {
  local vendor name server backend
  vendor="$(detect_vendor)"; name="$(detect_name "$vendor")"
  printf 'Detected: %s (%s)\n' "$name" "$vendor"
  case "$vendor" in
    nvidia|amd) ;;
    *) echo 'No supported NVIDIA or AMD compute GPU was detected.' >&2; return 1 ;;
  esac
  if ! server="$(find_aligned_server "$vendor")"; then
    printf 'No %s-enabled llama-server was found. Build one, then run the scan again.\n' "$vendor" >&2
    return 1
  fi
  backend="$(binary_backend "$server")"
  [[ "$backend" == "$vendor" ]] || { echo "Refusing mismatched llama-server: $server ($backend)" >&2; return 1; }
  ensure_local_metadata
  arkey_save_gpu_vendor "$vendor"
  arkey_save_gpu_name "$name"
  arkey_save_llama_server "$server"
  printf 'Aligned llama.cpp: %s\nSaved server: %s\n' "$backend" "$server"
}

case "${1:-}" in
  scan) [[ "$#" -eq 1 ]] || exit 2; scan_gpu ;;
  summary) [[ "$#" -eq 1 ]] || exit 2; summary ;;
  detect) [[ "$#" -eq 1 ]] || exit 2; vendor="$(detect_vendor)"; printf '%s\t%s\n' "$vendor" "$(detect_name "$vendor")" ;;
  backend) [[ "$#" -eq 2 ]] || exit 2; binary_backend "$2" ;;
  *) echo 'Usage: arkey-hardware-scan {scan|summary|detect|backend LLAMA_SERVER}' >&2; exit 2 ;;
esac
