#!/usr/bin/env bash
set -euo pipefail

ARKEY_USER_HOME="${ARKEY_USER_HOME:-${HOME:?HOME is required}}"
DEFAULT_CODEX_HOME="${ARKEY_USER_HOME}/.codex-moonbridge"
MOONBRIDGE_MODEL_PROVIDER='model_provider="moonbridge"'
BOOT_MENU="${ARKEY_BOOT_MENU:-${ARKEY_USER_HOME}/.local/bin/arkey-boot-menu}"
BOOT_LIB="${ARKEY_BOOT_LIB:-${ARKEY_USER_HOME}/.local/bin/arkey-boot-lib}"
CODEX_MOONBRIDGE_BIN="${CODEX_MOONBRIDGE_BIN:-${ARKEY_USER_HOME}/.local/bin/codex-moonbridge}"

if [[ ! -r "$BOOT_LIB" ]]; then
  echo "Arkey boot configuration library is missing: $BOOT_LIB" >&2
  exit 1
fi
# shellcheck source=arkey-boot-lib
source "$BOOT_LIB"
DEFAULT_MODEL="$(arkey_selected_model)"

export CODEX_HOME="${CODEX_HOME:-$DEFAULT_CODEX_HOME}"

args=()
has_model=false
has_model_provider=false
force_boot=false
suppress_boot=false
preserve_session_model=false
skip_next=false

# Arkey-owned flags are only recognized before the first Codex argument. This
# keeps prompt and subcommand payloads such as `exec -- --boot` untouched.
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --boot)
      force_boot=true
      shift
      ;;
    --no-boot)
      suppress_boot=true
      shift
      ;;
    --preserve-session-model)
      preserve_session_model=true
      shift
      ;;
    *)
      break
      ;;
  esac
done

for arg in "$@"; do
  if [[ "$skip_next" == true ]]; then
    case "$arg" in
      model=*) has_model=true ;;
      model_provider=*) has_model_provider=true ;;
    esac
    args+=("$arg")
    skip_next=false
    continue
  fi

  case "$arg" in
    -m|--model)
      has_model=true
      args+=("$arg")
      skip_next=true
      ;;
    --model=*)
      has_model=true
      args+=("$arg")
      ;;
    -c|--config)
      args+=("$arg")
      skip_next=true
      ;;
    --config=*)
      args+=("$arg")
      if [[ "$arg" == --config=model=* ]]; then
        has_model=true
      elif [[ "$arg" == --config=model_provider=* ]]; then
        has_model_provider=true
      fi
      ;;
    *) args+=("$arg") ;;
  esac
done

if [[ "$force_boot" == true && "$suppress_boot" == true ]]; then
  echo "Arkey options --boot and --no-boot cannot be used together." >&2
  exit 2
fi

if [[ "$force_boot" == true && "${#args[@]}" -gt 0 ]]; then
  echo "Arkey option --boot does not accept Codex arguments." >&2
  exit 2
fi

if [[ "$force_boot" == true ]] || {
  [[ "$suppress_boot" == false ]] &&
  [[ "${ARKEY_BOOT:-1}" != "0" ]] &&
  [[ "${#args[@]}" -eq 0 ]] &&
  [[ -t 0 ]] &&
  [[ -t 1 ]]
}; then
  if [[ ! -x "$BOOT_MENU" ]]; then
    echo "Arkey boot menu is not executable: $BOOT_MENU" >&2
    exit 1
  fi
  exec "$BOOT_MENU"
fi

if [[ "$has_model" == false && "$preserve_session_model" == false ]]; then
  args=("-c" "model=$DEFAULT_MODEL" "${args[@]}")
fi

if [[ "$has_model_provider" == false ]]; then
  args=("-c" "$MOONBRIDGE_MODEL_PROVIDER" "${args[@]}")
fi

exec "$CODEX_MOONBRIDGE_BIN" "${args[@]}"
