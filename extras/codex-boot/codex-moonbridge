#!/usr/bin/env bash
set -euo pipefail

arkey_user_home="${ARKEY_USER_HOME:-${HOME:?HOME is required}}"
moonbridge_addr="${MOONBRIDGE_ADDR:-127.0.0.1:38440}"
local_manager="${ARKEY_LOCAL_MANAGER:-${arkey_user_home}/.local/bin/arkey-local-runtime}"
codex_home_dir="${CODEX_HOME:-${arkey_user_home}/.codex-moonbridge}"
codex_bin="${CODEX_BIN:-${arkey_user_home}/.local/bin/codex-openai}"

if ! curl -fsS --max-time 1 "http://${moonbridge_addr}/v1/models" >/dev/null 2>&1; then
  [[ -x "$local_manager" ]] || { echo "Arkey local manager is missing: $local_manager" >&2; exit 1; }
  "$local_manager" reload-moonbridge
fi
curl -fsS --max-time 1 "http://${moonbridge_addr}/v1/models" >/dev/null 2>&1 || {
  echo "MoonBridge is unavailable at http://${moonbridge_addr}." >&2
  exit 1
}
[[ -x "$codex_bin" ]] || { echo "Arkey Codex binary is missing: $codex_bin" >&2; exit 1; }

export CODEX_HOME="$codex_home_dir"
export CODEX_THREAD_ID=""

args=("$@")
if [[ "${#args[@]}" -gt 0 && "${args[0]}" == exec ]]; then
  has_skip=false
  for arg in "${args[@]}"; do
    [[ "$arg" == --skip-git-repo-check ]] && { has_skip=true; break; }
  done
  [[ "$has_skip" == true ]] || args=("${args[0]}" --skip-git-repo-check "${args[@]:1}")
fi

exec "$codex_bin" --sandbox workspace-write "${args[@]}"
